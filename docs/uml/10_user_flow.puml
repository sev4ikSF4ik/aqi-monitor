@startuml
!include _style.iuml
start
:Головна сторінка: карта + список;
if (Як знайти місто?) then (пошук)
  :Ввести назву в поле пошуку;
  :Обрати місто у списку;
else (карта)
  :Клік по маркеру на карті;
endif
:Сторінка міста: AQI, забруднювачі, графік;
if (Що далі?) then (порівняти)
  :Порівняння: до 3 міст, графік, таблиця;
  stop
else (стежити)
  :Додати місто до обраних (зірочка);
  :Сторінка «Сповіщення»: поріг AQI,\nдозвіл браузера;
  if (AQI ≥ поріг?) then ([так])
    :Банер про перевищення\nна будь-якій сторінці;
    :Перехід до міста з банера;
  else ([ні])
    :Стеження у фоні\n(оновлення кожні 15 хв);
  endif
  stop
endif
@enduml
