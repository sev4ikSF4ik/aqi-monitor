@startuml
!include _style.iuml
start
:Користувач вмикає перемикач\n«Показувати системне сповіщення»;
if (Браузер підтримує Notification?) then ([так])
  if (Дозвіл = default?) then ([так])
    :Запитати дозвіл (requestPermission);
  else ([ні])
  endif
  if (Дозвіл = granted?) then ([так])
    :Зберегти notifications = true;
    :При кожному оновленні даних\nсповіщати про обрані міста понад поріг;
  else ([ні])
    :Залишити перемикач вимкненим,\nпоказати попередження;
  endif
else ([ні])
  :Вимкнути перемикач, показати\n«браузер не підтримує»;
endif
stop
@enduml
